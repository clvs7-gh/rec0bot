{
  "name": "rec0-bot",
  "version": "3.0.2",
  "description": "A bot for revolution of comm :)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "npm run exec-ts",
    "start:js": "npm run build && npm run exec",
    "build": "tsc",
    "exec": "node ./output/index.js",
    "exec-ts": "tsx src/index.ts",
    "test": "bash -c \"source src/__tests__/env.sh && vitest run\"",
    "lint": "eslint --ext .ts ."
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@slack/socket-mode": "^2.0.6",
    "@slack/web-api": "^7.15.0",
    "cron": "^4.4.0",
    "es-toolkit": "^1.45.1",
    "log4js": "^6.9.1",
    "vitest": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}
