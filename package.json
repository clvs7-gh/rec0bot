{
  "name": "rec0-bot",
  "version": "3.0.3",
  "description": "A bot for revolution of comm :)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "npm run exec-ts",
    "start:js": "npm run build && npm run exec",
    "build": "tsc",
    "exec": "node ./output/index.js",
    "exec-ts": "tsx src/index.ts",
    "test": "bash -c \"source src/__tests__/env.sh && vitest run\"",
    "lint": "eslint --ext .ts ."
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "cron": "^4.4.0",
    "es-toolkit": "^1.50.0",
    "log4js": "^6.9.1",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
